{
  "name": "Grove Deck",
  "version": "1.0.0",
  "author": "",
  "description": "知識工作者簡報，低飽和墨綠色系，與 Grove 講義同一套系。",
  "pageSize": "16:9",
  "tags": ["簡報", "現代", "Sans-serif", "筆記"],
  "palette": ["#1e3028", "#3d6b4f", "#7aaa8c", "#c4d4c8", "#f2f5f2"],
  "preview": "preview.png",
  "blocks": [
    {
      "name": "封面",
      "key": "layout-cover",
      "icon": "🎯",
      "class": "block-cover",
      "children": [
        { "type": "label", "placeholder": "標題" },
        { "type": "paragraph", "placeholder": "副標題或講師姓名…" }
      ]
    },
    {
      "name": "標題＋內容",
      "key": "layout-title-content",
      "icon": "📄",
      "class": "block-title-content",
      "children": [
        { "type": "label", "placeholder": "投影片標題" },
        { "type": "paragraph", "placeholder": "內容…" }
      ]
    },
    {
      "name": "兩欄並排",
      "key": "layout-two-col",
      "icon": "⬛",
      "class": "block-two-col",
      "children": [
        { "type": "paragraph", "placeholder": "左欄…" },
        { "type": "paragraph", "placeholder": "右欄…" }
      ]
    },
    {
      "name": "全版內容",
      "key": "layout-full",
      "icon": "🔲",
      "class": "block-full",
      "children": [
        { "type": "paragraph", "placeholder": "內容…" }
      ]
    },
    {
      "name": "章節過場",
      "key": "layout-section",
      "icon": "📌",
      "class": "block-section",
      "children": [
        { "type": "label", "placeholder": "章節標題" },
        { "type": "paragraph", "placeholder": "說明文字…" }
      ]
    }
  ]
}
